# Copy this file to backend/.env and fill in real values. Never commit backend/.env.

# PostgreSQL connection string (Render provides this automatically for linked databases).
DATABASE_URL="postgresql://user:password@localhost:5432/goldsilvershop"

# Long random string used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"

# Port the server listens on. Render sets this automatically; use 4000 for local dev.
PORT=4000

NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS when frontend and backend are on
# different origins (e.g. local dev). Leave unset in production (single-service deployment).
CORS_ORIGIN=http://localhost:5173

# Optional: set these once, run `npm run seed`, then remove them. Creates the first admin
# account only if no user with this email exists yet. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
